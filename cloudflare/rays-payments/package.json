{
  "name": "nebula-shop-payments",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "wrangler deploy --env sandbox --dry-run --outdir ../../.private/qa/raysbouquetz/worker-bundle",
