{
  "name": "nebula-platform-private-beta",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node ../../builder/tools/build-platform.cjs",
    "pretest": "npm run build",
    "precheck": "npm run build",
    "predev": "npm run build",
    "predeploy": "npm run build",
    "test": "node --test test/*.test.mjs",
    "check": "wrangler deploy --dry-run --outdir ../../.private/qa/platform-bundle",
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 4192 --persist-to ../../.private/qa/platform-state",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.151.3"
  }
}
