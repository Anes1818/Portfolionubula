{
  "name": "nebula",
  "account_id": "1b65e5ab35edeaa924ddf8fcff2e95aa",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "assets": {
    "directory": "../../platform/public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true,
  },
  "vars": {
    "ENVIRONMENT": "private-beta",
    "PUBLIC_ORIGIN": "https://nebula.aneslaidaoui06.workers.dev",
    "FIREBASE_PROJECT_ID": "la-flora-6ed47",
    "PUBLIC_SIGNUPS": "false",
    "BETA_ACCESS_EMAILS": "anescareer@gmail.com,aneslaidaoui06@gmail.com",
    "BILLING_ENABLED": "false",
    "CHECKOUT_ENABLED": "false",
    "PUBLISHING_ENABLED": "false",
  },
  "durable_objects": {
    "bindings": [
      { "name": "REGISTRY", "class_name": "ShopRegistry" },
      { "name": "SHOPS", "class_name": "ShopStore" },
    ],
  },
  "migrations": [
    {
      "tag": "platform-v1",
      "new_sqlite_classes": ["ShopRegistry", "ShopStore"],
    },
  ],
}
