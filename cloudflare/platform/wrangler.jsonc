{
  "name": "nebula",
  "account_id": "1b65e5ab35edeaa924ddf8fcff2e95aa",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "app.nebulastudio.site", "custom_domain": true }],
  "observability": { "enabled": false },
  "assets": {
    "directory": "../../platform/public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": [
      "/",
      "/index.html",
      "/login",
      "/login/",
      "/dashboard",
      "/dashboard/*",
      "/admin",
      "/admin/",
      "/admin/*",
      "/admin.html",
      "/s/*",
      "/api/*",
    ],
  },
  "vars": {
    "ENVIRONMENT": "private-beta",
    "PUBLIC_ORIGIN": "https://app.nebulastudio.site",
    "CANONICAL_ORIGIN": "https://app.nebulastudio.site",
    "FIREBASE_PROJECT_ID": "la-flora-6ed47",
    "PUBLIC_SIGNUPS": "true",
    "BETA_ACCESS_EMAILS": "anescareer@gmail.com,aneslaidaoui06@gmail.com",
    "BILLING_ENABLED": "false",
    "MANUAL_ACTIVATION_ENABLED": "true",
    "CHECKOUT_ENABLED": "false",
    "SQUARE_ENVIRONMENT": "sandbox",
    "SQUARE_SANDBOX_CONNECT_ENABLED": "false",
    "SQUARE_PRODUCTION_CONNECT_ENABLED": "false",
    "SQUARE_LIVE_APPROVED": "false",
    "PUBLISHING_ENABLED": "true",
  },
  "durable_objects": {
    "bindings": [
      { "name": "REGISTRY", "class_name": "ShopRegistry" },
      { "name": "SHOPS", "class_name": "ShopStore" },
    ],
  },
  "migrations": [
    {
      "tag": "platform-v1",
      "new_sqlite_classes": ["ShopRegistry", "ShopStore"],
    },
  ],
}
